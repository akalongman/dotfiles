// Zed global tasks: the "custom menu" replacement. Open with the
// task: spawn action (bound to shift-ctrl-\, the old PhpStorm
// QuickList.Handy Actions key). Per-project tasks go in .zed/tasks.json.
[
  {
    "label": "Pint: fix current file",
    "command": "vendor/bin/pint",
    "args": ["$ZED_RELATIVE_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Pint: fix dirty files",
    "command": "vendor/bin/pint",
    "args": ["--dirty"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Artisan: test current file",
    "command": "php",
    "args": ["artisan", "test", "$ZED_RELATIVE_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    // Inspections stand-in: no PHPStan language server exists for Zed, so
    // the report lands in the terminal with clickable file:line paths
    "label": "PHPStan: analyse",
    "command": "vendor/bin/phpstan",
    "args": ["analyse", "--memory-limit=1G", "--error-format=raw"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "PHPStan: analyse current file",
    "command": "vendor/bin/phpstan",
    "args": ["analyse", "--memory-limit=1G", "--error-format=raw", "$ZED_RELATIVE_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Composer: test",
    "command": "composer",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Artisan: migrate",
    "command": "php",
    "args": ["artisan", "migrate"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Artisan: route:list",
    "command": "php",
    "args": ["artisan", "route:list"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Artisan: tinker",
    "command": "php",
    "args": ["artisan", "tinker"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true
  },
  {
    // Runs after the title-bar worktree picker creates a linked worktree.
    // .env is gitignored, so the copy is the only thing a fresh worktree
    // cannot get from git; vendor/ and node_modules/ stay a manual step
    "label": "Worktree: copy .env from main checkout",
    "command": "cp",
    "args": ["--no-clobber", "$ZED_MAIN_GIT_WORKTREE/.env", "$ZED_WORKTREE_ROOT/.env"],
    "hooks": ["create_worktree"],
    "reveal": "no_focus",
    "hide": "on_success"
  }
]
