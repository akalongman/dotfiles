#!/usr/bin/env bash
# One tmux terminal, one window of its project.
#
# Every terminal (Zed's terminal.shell.program, the tmux block at the end of
# ~/.bashrc) runs this script in its working directory. The directory maps to
# a session key (key_for below); the key names a detached holder session that
# owns the project's windows and is never attached. Each terminal is a grouped
# view <key>_<pid> of the holder, shown on one window no other terminal shows,
# and destroys itself when its client closes while the window lives on in the
# holder. The pick and the claim run under a per-key lock, so terminals that
# open together never land on one window.
#
# When tmux cannot be used, the terminal gets a plain shell with NO_TMUX=1
# set, so the shell's own startup does not try again.
#
# Design: ~/.claude/docs/specs/2026-10-10-tmux-attach-design.md.
#
# Usage: tmux-attach              attach this terminal (replaces the process)
#        tmux-attach --key [dir]  print the session key of dir (default: .)

set -u

# key_for dir: the session key on stdout; status 1 when there is none.
# ~ is main; under ~/projects the first two path components (three under
# oss) joined with -; elsewhere the basename of the git top level unless
# that is ~ (the yadm gitlink), else the directory's basename. Everything
# outside A-Z a-z 0-9 - becomes -, so a key never contains _, which is
# what separates a view's pid from its key.
key_for() {
    local dir rel p1 p2 p3 rest key="" top
    dir=$(cd -- "$1" 2>/dev/null && pwd) || return 1
    if [ "$dir" = "$HOME" ]; then
        printf 'main\n'
        return 0
    fi
    case "$dir" in
        "$HOME"/projects/?*)
            rel=${dir#"$HOME"/projects/}
            IFS=/ read -r p1 p2 p3 rest <<< "$rel"
            if [ "$p1" = oss ] && [ -n "$p3" ]; then
                key="$p1-$p2-$p3"
            elif [ -n "$p2" ]; then
                key="$p1-$p2"
            fi
            ;;
    esac
    if [ -z "$key" ]; then
        top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)
        if [ -n "$top" ] && [ "$top" != "$HOME" ]; then
            key=${top##*/}
        else
            key=${dir##*/}
        fi
    fi
    key=$(printf '%s' "$key" | tr -c 'A-Za-z0-9-' '-' | sed 's/^-*//; s/-*$//')
    [ -n "$key" ] || return 1
    printf '%s\n' "$key"
}

case "${1:-}" in
    --key) key_for "${2:-.}"; exit ;;
    '') ;;
    *) printf 'usage: tmux-attach [--key [dir]]\n' >&2; exit 2 ;;
esac

# fallback [message]: give the terminal a plain shell instead of a dead tab.
fallback() {
    [ -z "${1:-}" ] || printf 'tmux-attach: %s; starting a plain shell\n' "$1" >&2
    NO_TMUX=1 exec "${SHELL:-/bin/bash}"
}

[ -z "${TMUX:-}" ] || fallback
dir=$(pwd)
key=$(key_for "$dir") || fallback "no session key for $dir"
view="${key}_$$"

# The server. It exits when it has no sessions, so a terminal that finds no
# server starts it with a throwaway session, killed once the view exists.
boot=0
if ! tmux list-sessions >/dev/null 2>&1; then
    tmux new-session -d -s tmux-attach_boot -c / 2>/dev/null && boot=1
    tmux list-sessions >/dev/null 2>&1 || fallback "cannot start the tmux server"
fi

# The holder, created detached in the terminal's directory when missing.
if ! tmux has-session -t "=$key" 2>/dev/null; then
    tmux new-session -d -s "$key" -c "$dir" 2>/dev/null || fallback "cannot create the session $key"
fi

# The pick: the first holder window that is not the current window of the
# holder itself when a client attached it by hand, or of an attached member
# of its group.
group=$(tmux display -p -t "=$key:" '#{session_group}' 2>/dev/null)
taken=$(tmux list-sessions -F '#{session_name}|#{session_group}|#{session_attached}|#{window_id}' 2>/dev/null \
    | awk -F'|' -v k="$key" -v g="$group" '($1 == k || (g != "" && $2 == g)) && $3 > 0 { print $4 }' | paste -sd '|')
target=""
for w in $(tmux list-windows -t "=$key" -F '#{window_id}' 2>/dev/null); do
    case "|$taken|" in
        *"|$w|"*) ;;
        *) target=$w; break ;;
    esac
done

# The claim: a detached view on the picked window, or on a new window in
# the terminal's directory when every window is shown.
if [ -n "$target" ]; then
    tmux new-session -d -t "=$key" -s "$view" \; select-window -t "=$view:$target"
else
    tmux new-session -d -t "=$key" -s "$view" \; new-window -t "=$view:" -c "$dir"
fi 2>/dev/null || fallback "cannot create the view $view"
[ "$boot" -eq 0 ] || tmux kill-session -t =tmux-attach_boot 2>/dev/null

exec tmux attach-session -t "=$view" \; set-option -t "=$view:" destroy-unattached on
