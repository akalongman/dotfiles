#!/usr/bin/env bash
#
# Kill tmux sessions that are provably doing nothing:
#   - a view that no client is attached to. A view is a grouped session
#     named <member>-<digits> after another member of its group: zed-term's
#     zed-<project>-<pid> tabs and the main-<id> sessions .bashrc opens. A
#     live view carries destroy-unattached and vanishes with its client;
#     tmux-resurrect restores views without it, so an unattached one is a
#     leftover of an earlier boot, and its windows live on in the member it
#     is named after.
#   - any other session that is
#     - not attached to any client
#     - single window, single pane
#     - the pane's shell has no child process (nothing running)
#     - no other session in its group has a client attached (a detached
#       holder such as zed-term's zed-<project> base keeps the shared windows
#       alive for the attached tabs; killing it would let the last tab's
#       destroy-unattached take the windows down with it)
#
# Never touches a session with work in it. Pass --apply to actually kill;
# default is a dry run.

set -uo pipefail

apply=0
[ "${1:-}" = "--apply" ] && apply=1

killed=0
kept=0

sessions=$(tmux list-sessions -F '#{session_name}|#{session_attached}|#{session_windows}|#{session_group}|#{session_group_attached}' 2>/dev/null)

is_view() { # name group: the group has a member named <name minus its -digits suffix>
    local suffix="${1##*-}" base="${1%-*}"
    case "$suffix" in ''|*[!0-9]*) return 1 ;; esac
    [ "$base" = "$1" ] && return 1
    printf '%s\n' "$sessions" \
        | awk -F'|' -v b="$base" -v g="$2" '$1 == b && $4 == g { found = 1 } END { exit !found }'
}

reap() { # name
    local path
    path=$(tmux list-panes -t "$1" -F '#{pane_current_path}' 2>/dev/null | head -1)
    if [ "$apply" -eq 1 ]; then
        tmux kill-session -t "=$1" 2>/dev/null && killed=$((killed + 1))
    else
        printf '  would kill  %-6s  (%s)\n' "$1" "$path"
        killed=$((killed + 1))
    fi
}

while IFS='|' read -r name attached windows group group_attached; do
    [ -z "$name" ] && continue

    if [ "$attached" != "0" ]; then
        kept=$((kept + 1)); continue
    fi
    if [ -n "$group" ] && is_view "$name" "$group"; then
        reap "$name"; continue
    fi
    if [ "${group_attached:-0}" != "0" ]; then
        kept=$((kept + 1)); continue
    fi
    if [ "$windows" != "1" ]; then
        kept=$((kept + 1)); continue
    fi

    panes=$(tmux list-panes -t "$name" -F '#{pane_pid}' 2>/dev/null)
    if [ "$(printf '%s\n' "$panes" | grep -c .)" != "1" ]; then
        kept=$((kept + 1)); continue
    fi

    if [ -n "$(pgrep -P "$panes" 2>/dev/null)" ]; then
        kept=$((kept + 1)); continue
    fi

    reap "$name"
done <<< "$sessions"

if [ "$apply" -eq 1 ]; then
    echo "reaped $killed idle sessions, kept $kept"
else
    echo
    echo "DRY RUN: would reap $killed, keep $kept. Re-run with --apply."
fi
