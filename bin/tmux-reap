#!/usr/bin/env bash
#
# Kill tmux sessions that are provably doing nothing:
#   - a view that no client is attached to. A view is a grouped session
#     named <key>_<digits>: the terminals tmux-attach opens, and the tabs
#     the Claude session focus script opens. A live view carries
#     destroy-unattached and vanishes with its client; tmux-resurrect
#     restores views without it, so an unattached one older than the grace
#     is a leftover of an earlier boot. It is killed only while another
#     member of its group survives this run, so the windows live on.
#   - any other session that is
#     - not attached to any client
#     - single window, single pane
#     - the pane's shell has no child process (nothing running)
#     - no other session in its group has a client attached (a detached
#       holder keeps the shared windows alive for the attached views;
#       killing it would let the last view's destroy-unattached take the
#       windows down with it)
#     - neither it nor a member of its group is younger than the grace (a
#       view is created unattached and attaches a moment later; its holder
#       has no client in between)
#
# The grace is 60 seconds, read from TMUX_REAP_GRACE for the tests.
# Before a kill the session is read again under its key's tmux-attach lock
# (same name, same creation time, still no client, no group member younger
# than the grace, and for a view another member of its group still there),
# so a terminal opening at that moment is never undercut; a busy lock keeps
# the session. A view's kill runs in one tmux command sequence behind a
# has-session on that member, and a failing command stops the rest of the
# sequence, so a member gone by the kill keeps the view.
# Never touches a session with work in it. Pass --apply to actually kill;
# default is a dry run.

set -uo pipefail

apply=0
[ "${1:-}" = "--apply" ] && apply=1

grace=${TMUX_REAP_GRACE:-60}
now=$(date +%s)
killed=0
kept=0
reaped=""

sessions=$(tmux list-sessions -F '#{session_name}|#{session_attached}|#{session_windows}|#{session_group}|#{session_group_attached}|#{session_created}' 2>/dev/null)

is_view() { # name group: name ends in _<digits> and another member of the group survives this run
    case "$1" in *_*) ;; *) return 1 ;; esac
    case "${1##*_}" in ''|*[!0-9]*) return 1 ;; esac
    printf '%s\n' "$sessions" \
        | awk -F'|' -v n="$1" -v g="$2" -v r="$reaped" '
            BEGIN { split(r, a, "\n"); for (i in a) gone[a[i]] = 1 }
            $4 == g && $1 != n && !($1 in gone) { found = 1 }
            END { exit !found }'
}

young() { # name group: the session, or a member of its group when group is set, is younger than the grace
    printf '%s\n' "$sessions" \
        | awk -F'|' -v n="$1" -v g="$2" -v now="$now" -v grace="$grace" '
            ($1 == n || (g != "" && $4 == g)) && now - $6 < grace { found = 1 }
            END { exit !found }'
}

still_idle() { # name created rule: the session still exists with that creation time, has no client, and no member of its group is younger than the grace; for the view rule another member of its group still exists, and its name is printed
    tmux list-sessions -F '#{session_name}|#{session_attached}|#{session_group}|#{session_created}' 2>/dev/null \
        | awk -F'|' -v n="$1" -v c="$2" -v rule="$3" -v now="$(date +%s)" -v grace="$grace" '
            { nm[NR] = $1; att[NR] = $2; grp[NR] = $3; born[NR] = $4 }
            $1 == n { seen = NR }
            END {
                if (!seen || att[seen] != "0" || born[seen] != c) exit 1
                for (i = 1; i <= NR; i++)
                    if (i != seen && grp[seen] != "" && grp[i] == grp[seen] && now - born[i] < grace) exit 1
                if (rule != "view") exit 0
                for (i = 1; i <= NR; i++)
                    if (i != seen && grp[seen] != "" && grp[i] == grp[seen]) { print nm[i]; exit 0 }
                exit 1
            }'
}

reap() { # name created rule
    local path lock member ok=0
    path=$(tmux list-panes -t "=$1:" -F '#{pane_current_path}' 2>/dev/null | head -1)
    if [ "$apply" -eq 1 ]; then
        # Under the key's lock (a view's key is its name up to the first _)
        # read the session again: the snapshot may predate a client, a view
        # joining its group, a replacement of the same name, or, for a view,
        # the last other member of its group going away. The lock is taken
        # on a command group, not with exec, so an unwritable lock file
        # fails the kill instead of the script.
        lock="${XDG_RUNTIME_DIR:-/tmp}/tmux-attach-${1%%_*}.lock"
        {
            if flock -w 2 9 && member=$(still_idle "$1" "$2" "$3"); then
                if [ "$3" = "view" ]; then
                    # has-session fails once the member is gone, and the
                    # failure stops the sequence before the kill.
                    tmux has-session -t "=$member" \; kill-session -t "=$1" 2>/dev/null && ok=1
                else
                    tmux kill-session -t "=$1" 2>/dev/null && ok=1
                fi
            fi
        } 9>"$lock" 2>/dev/null
        if [ "$ok" -eq 0 ]; then
            kept=$((kept + 1))
            return
        fi
        killed=$((killed + 1))
    else
        printf '  would kill  %-6s  (%s)\n' "$1" "$path"
        killed=$((killed + 1))
    fi
    reaped="$reaped$1"$'\n'
}

while IFS='|' read -r name attached windows group group_attached created; do
    [ -z "$name" ] && continue

    if [ "$attached" != "0" ]; then
        kept=$((kept + 1)); continue
    fi
    if [ -n "$group" ] && is_view "$name" "$group"; then
        if young "$name" ""; then
            kept=$((kept + 1)); continue
        fi
        reap "$name" "$created" view; continue
    fi
    if [ "${group_attached:-0}" != "0" ]; then
        kept=$((kept + 1)); continue
    fi
    if [ "$windows" != "1" ]; then
        kept=$((kept + 1)); continue
    fi
    if young "$name" "$group"; then
        kept=$((kept + 1)); continue
    fi

    panes=$(tmux list-panes -t "=$name:" -F '#{pane_pid}' 2>/dev/null)
    if [ "$(printf '%s\n' "$panes" | grep -c .)" != "1" ]; then
        kept=$((kept + 1)); continue
    fi

    if [ -n "$(pgrep -P "$panes" 2>/dev/null)" ]; then
        kept=$((kept + 1)); continue
    fi

    reap "$name" "$created" idle
done <<< "$sessions"

if [ "$apply" -eq 1 ]; then
    echo "reaped $killed idle sessions, kept $kept"
else
    echo
    echo "DRY RUN: would reap $killed, keep $kept. Re-run with --apply."
fi
