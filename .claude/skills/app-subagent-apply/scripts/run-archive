#!/usr/bin/env bash
# Copy an apply run's workspace and its facts to a place that outlives the
# workspace, the worktree and the transcript sweep:
#   <config dir>/docs/tmp/apply-runs/<project slug>/<YYYY-MM-DD-HHMM>-<name>/
# The project slug is the one the harness uses for transcripts (the working
# directory with every "/" replaced by "-"), so the run's transcript and its
# archive sit under the same name.
#
# Since 2026-10-27 it also parks each ledger line "Handed to <destination>:
# <item>" that has no "Parked: line <N>:" line yet in the project's queue
# through the laterbox engine (later), as the note "<Destination>: <item>
# Archive: <archive path>", and writes "Parked: line <N>: <destination>:
# <first six words>" to the ledger before copying it into the archive once
# more. A note the queue already lists (its text the key, alone or followed
# by " Archive: " and one absolute path under a docs/tmp/apply-runs/
# directory) gets its Parked: line and is not parked again, and so does a
# second line of one call with the same key. Each line is reported in ledger line order: "parked: line
# <N>, now note <P>: <first six words>" ("position unknown" in place of "now
# note <P>" when the queue no longer lists it), "parked earlier: line <N>, now
# note <P>: ..." for a note the queue already held, or "not parked (<reason>):
# <command>" when later is not on PATH or refuses, <command> parking the note
# in this project from any terminal, from the directory whose queue the note
# belongs to (the main checkout inside a repository, since 2026-10-28). A line
# with a "Withdrawn: line <N>:" line is reported "withdrawn: line <N>" and not
# parked, whether or not it also has
# a Parked: line; a line with no ": " or an empty destination is reported "not
# parked (malformed marker): line <N>", one with an empty item "not parked
# (empty item): line <N>". A Parked: line the ledger refuses (a write error)
# leaves the park standing and adds "not marked (ledger write failed): line
# <N>" after the line's report; the second ledger copy, made when the call
# wrote a Parked: line, adds "not archived (ledger copy failed): <archive
# ledger path>" after the report lines when it fails; neither fails the
# archive. When the call
# attempted a line (parked it, found it parked earlier, or reported it not
# parked because later is missing or refused it; a malformed marker or an
# empty item is never an attempt and adds nothing to a count) and the
# workspace's plan-path names a plan inside the repository, each attempted
# destination with a heading "## Handed to <destination>" in the plan (the
# heading compared case-insensitively with its whitespace collapsed) gets the
# line
#   offer: docs commit adding <count> items to "## Handed to <destination>" of <plan path>
#
# Usage: run-archive WORKSPACE_DIR [NAME]
#   WORKSPACE_DIR  the run's .superpowers/sdd/<name>/ directory
#   NAME           defaults to the workspace directory's basename
# Prints the report lines, then the offer lines, then the archive path, last.
# Exit 2 on usage or a missing workspace; a failed park never fails the
# archive.
set -euo pipefail

ws="${1:-}"; [ -d "$ws" ] || { echo "usage: run-archive WORKSPACE_DIR [NAME]" >&2; exit 2; }
name="${2:-$(basename "$ws")}"
config="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
slug="$(pwd | tr '/' '-')"
stamp="$(date +%Y-%m-%d-%H%M)"
dest="$config/docs/tmp/apply-runs/$slug/$stamp-$name"
mkdir -p "$dest"
cp -r "$ws"/. "$dest"/

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo none)"
sha="$(git rev-parse --short HEAD 2>/dev/null || echo none)"
remote="$(git config --get "branch.$branch.remote" 2>/dev/null || echo origin)"
host="$(git remote get-url "$remote" 2>/dev/null | sed -E 's#^[a-z+]+://##; s#^[^@]*@##; s#[:/].*$##' || true)"
skill_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
h() { sha256sum "$1" 2>/dev/null | cut -c1-12; }
session="${CLAUDE_CODE_SESSION_ID:-unknown}"
transcript="$config/projects/$slug/$session.jsonl"
if [ ! -f "$transcript" ]; then
  found="$(find "$HOME"/.claude*/projects -maxdepth 2 -name "$session.jsonl" 2>/dev/null | head -1)"
  transcript="${found:-$transcript (not found)}"
fi
{
  echo "# Run facts"
  echo "Archived: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "Session: $transcript"
  echo "Repository: $(pwd) on $branch at $sha, remote host ${host:-none}"
  echo "Skill: SKILL.md $(h "$skill_dir/SKILL.md"), unit-controller-overrides.md $(h "$skill_dir/prompts/unit-controller-overrides.md")"
  # The ledger's lines: the pre-flight read the copy the run loaded, and a
  # resumed run may ledger a second one.
  sub="$(grep '^Sub-skill:' "$ws/progress.md" 2>/dev/null || true)"
  echo "${sub:-Sub-skill: not ledgered}"
  echo "Workspace: $ws"
} > "$dest/run-facts.md"

# The park step. canon: stdin to one line, canonicalised as the engine stores
# a note (newlines, tabs and runs of whitespace to one space, ends trimmed).
canon() { tr '\n\r\t' '   ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//'; }
# The first six whitespace-separated words of $1, fewer when it has fewer.
first_words() { local -a w; read -r -a w <<< "$1"; printf '%s\n' "${w[*]:0:6}"; }
# Sets to and item, both canonicalised, from ledger line $1 by the grammar
# "Handed to <destination>: <item>", the destination running to the first
# ": "; fails when the line has none.
note_of() {
  local rest=${1#Handed to }
  case $rest in *': '*) ;; *) return 1 ;; esac
  to=$(printf '%s' "${rest%%: *}" | canon)
  item=$(printf '%s' "${rest#*: }" | canon)
}
# Prints the position of the first note in listing $2 (bare later's output)
# whose text is key $1, alone or followed by " Archive: " and one absolute
# path under a docs/tmp/apply-runs/ directory (the suffix this script and its
# pasted command write, under any config directory), and fails when there is
# none. The whole line must match, so a note whose text only begins with the
# key, or goes on with another item's " Archive: " text before the suffix
# (a sibling item this script parked), is never taken.
position() {
  local re='^ *([0-9]+)\. (.*) \([^()]*\)$' line text rest
  while IFS= read -r line; do
    [[ $line =~ $re ]] || continue
    text=${BASH_REMATCH[2]}
    rest=${text#"$1 Archive: "}
    if [ "$text" = "$1" ] || { [ "$rest" != "$text" ] && [[ $rest == /*/docs/tmp/apply-runs/* && $rest != *' Archive: '* ]]; }; then
      printf '%s\n' "${BASH_REMATCH[1]}"
      return 0
    fi
  done <<< "$2"
  return 1
}
# Appends line $1 to the ledger on a line of its own, even when the ledger
# lacks its final newline; fails, with nothing on stderr, when the ledger
# cannot be written.
ledger_line() {
  {
    if [ -n "$(tail -c1 "$ws/progress.md")" ]; then echo >> "$ws/progress.md"; fi
    printf '%s\n' "$1" >> "$ws/progress.md"
  } 2>/dev/null
}
# $1 single-quoted for the shell, each single quote in it written '\''.
sq() { local q="'\\''"; printf "'%s'" "${1//\'/$q}"; }
# Prints the directory whose queue a note parked from the working directory
# belongs to, resolved as the laterbox engine's project_root and queue_file
# resolve it (scripts/later.sh): one git call gives the top level, the git
# directory and the common git directory; the root is the top level, or for
# a linked worktree the common directory's parent (the main checkout),
# spelled as cd -P spells it (as git printed it when cd cannot enter it). A
# root equal to the home directory (a dotfiles repository) is discarded
# unless the working directory is the home directory itself, an exception
# pinned by case 16 of tools/test-run-archive.sh in the claude-subagent-apply
# repository. A discarded root, a failed call (outside a work tree, a bare
# repository, a git before 2.31 without --path-format) or a fourth line (a
# path holding a newline) gives the working directory as cd -P spells it.
# Untested here: the cd -P normalisation (git prints physical paths on this
# machine) and the fallback for a git without --path-format.
queue_dir() {
  local out dir p home='' root=''
  local -a l
  dir=$(cd -P "$PWD" 2>/dev/null && pwd) || dir=$PWD
  if [ -n "${HOME:-}" ]; then home=$(cd -P "$HOME" 2>/dev/null && pwd) || home=''; fi
  if out=$(git -C "$PWD" rev-parse --path-format=absolute --show-toplevel --git-dir --git-common-dir 2>/dev/null) \
    && mapfile -t l <<< "$out" && [ "${#l[@]}" -eq 3 ]; then
    root=${l[0]}
    if [ "${l[1]}" != "${l[2]}" ]; then root=${l[2]%/*}; root=${root:-/}; fi
    if p=$(cd -P "$root" 2>/dev/null && pwd); then root=$p; fi
    if [ -n "$home" ] && [ "$root" = "$home" ] && [ "$dir" != "$home" ]; then root=''; fi
  fi
  printf '%s\n' "${root:-$dir}"
}
# The paste-ready command that parks note $1 in this project's queue from any
# terminal, from qdir, the queue's directory (a global park_handed sets once).
park_cmd() { printf '(cd %s && later -- %s)' "$(sq "$qdir")" "$(sq "$1")"; }
# Prints the offer lines: one per destination among the lines this call
# attempted (tos, set by park_handed) that the workspace's plan has a heading
# "## Handed to <destination>" for, the whole heading compared lower-cased
# with whitespace collapsed, in ledger order of the destination's first line.
# The offer names the destination as the plan spells it. The plan is
# plan-path resolved against the top level of the working directory's work
# tree; an absolute plan-path (outside the repository), a working directory
# outside every repository or a missing plan gives none.
offers() {
  local plan root heading d n hre='^## handed to (.*)$'
  local -a order=()
  local -A shown=() count=()
  [ "${#tos[@]}" -gt 0 ] && [ -f "$ws/plan-path" ] && plan=$(cat "$ws/plan-path" 2>/dev/null) || return 0
  case $plan in '' | /*) return 0 ;; esac
  root=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null) && [ -f "$root/$plan" ] || return 0
  while IFS= read -r heading; do
    heading=$(printf '%s' "$heading" | canon)
    [[ ${heading,,} =~ $hre ]] || continue
    d=${heading:${#heading}-${#BASH_REMATCH[1]}}
    [ -n "$d" ] && [ -z "${shown[${d,,}]:-}" ] || continue
    shown[${d,,}]=$d
  done < <(grep -iE '^##[[:space:]]+handed[[:space:]]+to[[:space:]]' -- "$root/$plan" 2>/dev/null || true)
  for n in "${!tos[@]}"; do
    d=${tos[n],,}
    [ -n "${count[$d]:-}" ] || order+=("$d")
    count[$d]=$((${count[$d]:-0} + 1))
  done
  for d in "${order[@]}"; do
    [ -n "${shown[$d]:-}" ] || continue
    printf 'offer: docs commit adding %s items to "## Handed to %s" of %s\n' "${count[$d]}" "${shown[$d]}" "$plan"
  done
}
# Parks each Handed to line of the ledger that has no Parked: line yet: reports
# a withdrawn line (Parked: or not), a malformed marker or an empty item and
# goes on; with no later on PATH, reports the command that parks it; else
# marks a note the queue already lists (the guard, one listing before the
# loop) or one this call parked for an earlier line with the same key, or
# parks it and appends its Parked: line in the same iteration, or reports the
# refusal. Then finds each new note's position in the queue, reports a
# Parked: line the ledger refused, copies the ledger into the archive once
# more when a Parked: line was written (reported when the copy fails) and
# prints the report lines in ledger line order, then the offer lines.
park_handed() {
  local n line to item why k listing p archive written='' copy_failed=''
  local -a lines report=() tos=() keys=() notes=() firsts=() kind=() unwritten=()
  local -A parked=() withdrawn=() seen=()
  qdir=$(queue_dir)
  mapfile -t lines < "$ws/progress.md"
  for line in "${lines[@]}"; do
    if [[ $line =~ ^Parked:\ line\ ([0-9]+): ]]; then parked[${BASH_REMATCH[1]}]=1; fi
    if [[ $line =~ ^Withdrawn:\ line\ ([0-9]+): ]]; then withdrawn[${BASH_REMATCH[1]}]=1; fi
  done
  archive=$(printf '%s' "$dest" | canon)
  for ((n = 1; n <= ${#lines[@]}; n++)); do
    line=${lines[n - 1]}
    [[ $line == 'Handed to '* ]] || continue
    if [ -n "${withdrawn[$n]:-}" ]; then report[n]="withdrawn: line $n"; continue; fi
    [ -z "${parked[$n]:-}" ] || continue
    if ! note_of "$line" || [ -z "$to" ]; then report[n]="not parked (malformed marker): line $n"; continue; fi
    if [ -z "$item" ]; then report[n]="not parked (empty item): line $n"; continue; fi
    tos[n]=$to
    keys[n]="${to^}: $item"
    notes[n]="${keys[n]} Archive: $archive"
    firsts[n]=$(first_words "$item")
  done
  if [ "${#keys[@]}" -gt 0 ] && ! command -v later >/dev/null; then
    for n in "${!keys[@]}"; do report[n]="not parked (later not on PATH): $(park_cmd "${notes[n]}")"; done
  elif [ "${#keys[@]}" -gt 0 ]; then
    listing=$(later 2>/dev/null) || listing=
    for n in "${!keys[@]}"; do
      if [ -n "${seen["${keys[n]}"]:-}" ]; then
        kind[n]='parked earlier'
      elif p=$(position "${keys[n]}" "$listing"); then
        report[n]="parked earlier: line $n, now note $p: ${firsts[n]}"
      elif why=$(later -- "${notes[n]}" 2>&1 >/dev/null); then
        kind[n]=parked; seen["${keys[n]}"]=1
      else
        k=$?
        why=${why%%$'\n'*}
        report[n]="not parked (${why:-later exited $k}): $(park_cmd "${notes[n]}")"
        continue
      fi
      if ledger_line "Parked: line $n: ${tos[n]}: ${firsts[n]}"; then written=1; else unwritten[n]=1; fi
    done
  fi
  # The lines whose position is read after the parks: this call's own parks
  # and the repeats of their keys.
  if [ "${#kind[@]}" -gt 0 ]; then
    listing=$(later 2>/dev/null) || listing=
    for n in "${!kind[@]}"; do
      if p=$(position "${keys[n]}" "$listing"); then
        report[n]="${kind[n]}: line $n, now note $p: ${firsts[n]}"
      else
        report[n]="${kind[n]}: line $n, position unknown: ${firsts[n]}"
      fi
    done
  fi
  for n in "${!unwritten[@]}"; do report[n]+=$'\n'"not marked (ledger write failed): line $n"; done
  if [ -n "$written" ]; then cp "$ws/progress.md" "$dest/progress.md" 2>/dev/null || copy_failed=1; fi
  for n in "${!report[@]}"; do printf '%s\n' "${report[n]}"; done
  [ -z "$copy_failed" ] || echo "not archived (ledger copy failed): $dest/progress.md"
  offers
}
if [ -f "$ws/progress.md" ]; then park_handed; fi
echo "$dest"
