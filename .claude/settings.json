{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "cleanupPeriodDays": 1825,
  "env": {
    "AZURE_MCP_COLLECT_TELEMETRY": "false",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
    "FORCE_HYPERLINK": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    "BASH_DEFAULT_TIMEOUT_MS": "300000"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(sdp --help:*)",
      "Bash(sdp doctor:*)",
      "Bash(sdp help:*)",
      "Bash(sdp mine:*)",
      "Bash(sdp notes:*)",
      "Bash(sdp request:*)",
      "Bash(sdp requests:*)",
      "Bash(sdp search:*)",
      "Bash(sdp task:*)",
      "Bash(sdp tasks:*)",
      "Bash(ftpx servers:*)",
      "Bash(ftpx check:*)",
      "Bash(ftpx ls:*)",
      "Bash(ftpx lsd:*)",
      "Bash(ftpx lsl:*)",
      "Bash(ftpx cat:*)",
      "Bash(ftpx size:*)",
      "Bash(ftpx pull:*)",
      "Bash(cfx)",
      "Bash(cfx --help)",
      "Bash(cfx * accounts list *)",
      "Bash(cfx * accounts tokens verify *)",
      "Bash(cfx * zones list *)",
      "Bash(cfx * zones get *)",
      "Bash(cfx * dns records list *)",
      "Bash(cfx * dns records get *)",
      "Bash(cfx * kv namespaces list *)",
      "Bash(cf --version)",
      "Bash(cf cli search *)",
      "Bash(cf docs search *)",
      "Bash(cf schema *)",
      "Read(~/.claude*/**)",
      "Edit(~/.claude*/**)"
    ],
    "ask": [
      "Bash(sdp login:*)",
      "Bash(sdp task comment:*)",
      "Bash(sdp task status:*)",
      "Bash(sdp task worklog:*)",
      "Bash(cfx * --force *)",
      "Bash(cfx * --force)",
      "Bash(cfx * -f *)",
      "Bash(cfx * -f)",
      "Bash(cfx * delete *)",
      "Bash(cfx * purge *)",
      "Bash(cfx * update *)",
      "Bash(cfx * edit *)",
      "Bash(cf * --force *)",
      "Bash(cf * --force)",
      "Bash(cf * -f *)",
      "Bash(cf * -f)",
      "Bash(cf * delete *)",
      "Bash(cf * purge *)",
      "Bash(cf * update *)",
      "Bash(cf * edit *)",
      "Bash(secrets:*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.claude",
      "~/.claude2",
      "~/.claude3"
    ]
  },
  "model": "opus",
  "fallbackModel": [
    "opus"
  ],
  "enableAllProjectMcpServers": false,
  "skillOverrides": {
    "app-rabbitmq-guidelines": "user-invocable-only",
    "app-socratic-probe": "off",
    "diagnosing-bugs": "user-invocable-only",
    "app-investigate-incident": "user-invocable-only",
    "app-pdf-doc": "user-invocable-only",
    "app-retro": "user-invocable-only",
    "app-openspec-drift": "user-invocable-only",
    "app-compact-constitution": "user-invocable-only",
    "app-review-project": "user-invocable-only",
    "app-audit-server": "user-invocable-only",
    "app-workstation-project": "user-invocable-only"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/hooks.sh notification",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/hooks.sh stop",
            "async": true
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/worktree.sh hook-create",
            "timeout": 900,
            "statusMessage": "Creating worktree and running worktree:setup..."
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/worktree.sh hook-remove",
            "timeout": 300,
            "statusMessage": "Running worktree:teardown and removing worktree..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/push-guard.sh hook"
          }
        ]
      }
    ]
  },
  "disableAllHooks": false,
  "bashOutputMaxChars": 128000,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "phpstorm-plugin@phpstorm-marketplace": true,
    "security-guidance@claude-plugins-official": false,
    "azure@claude-plugins-official": false,
    "php-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "slack@claude-plugins-official": false,
    "human-resources@synced": false,
    "cowork-plugin-management@synced": false,
    "cc-plugin-you-should-know@builtin": true,
    "superpowers@superpowers-marketplace": true,
    "tmux-session-state@personal": true,
    "laterbox@akalongman": true
  },
  "extraKnownMarketplaces": {
    "phpstorm-marketplace": {
      "source": {
        "source": "github",
        "repo": "jetbrains/phpstorm-claude-marketplace"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "personal": {
      "source": {
        "source": "directory",
        "path": "/home/longman/projects/personal/claude-plugins"
      }
    },
    "akalongman": {
      "source": {
        "source": "directory",
        "path": "/home/longman/projects/akalongman/claude-laterbox"
      }
    }
  },
  "outputStyle": "Explanatory",
  "feedbackSurveyRate": 0,
  "spinnerTipsEnabled": true,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Thinking"
    ]
  },
  "spellcheck": {
    "enabled": true,
    "language": "en_US"
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "awaySummaryEnabled": true,
  "tui": "fullscreen",
  "timeFormat": "24-hour",
  "skipDangerousModePermissionPrompt": false,
  "skipWorkflowUsageWarning": true,
  "autoCompactEnabled": true,
  "precomputeCompactionEnabled": true,
  "switchModelsOnFlag": false,
  "showTurnDuration": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
